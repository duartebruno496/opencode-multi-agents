# === Configurações de IA ===
# Padrão: modelo gratuito (nenhum token necessário)
# Se quiser usar modelos pagos, descomente e configure abaixo
OPENCODE_PROVIDER=opencode
OPENCODE_MODEL=opencode/big-pickle
# OPENCODE_API_KEY=

# === GitHub (opcional) ===
GITHUB_TOKEN=

# === AWS (opcional) ===
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# === Database (opcional) ===
DATABASE_URL=

